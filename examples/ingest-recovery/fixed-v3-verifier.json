{
  "check.py": "import base64\nimport json\nimport os\nfrom pathlib import Path\nimport subprocess\nimport sys\nimport tempfile\nsys.path.insert(0, str(Path.cwd()))\nfrom eventflow import Event, State, process\n\nDATA = [{\"tenant\":\"alpha\",\"event_id\":\"e1\",\"amount\":7},{\"tenant\":\"alpha\",\"event_id\":\"e2\",\"amount\":-2},{\"tenant\":\"alpha\",\"event_id\":\"e1\",\"amount\":7}]\n\ndef ordinary(path):\n    for amount in [-(2**31), 2**31-1, 0]:\n        assert Event.parse({\"tenant\":\"bounds\",\"event_id\":\"b\",\"amount\":amount}).amount == amount\n    state = State(path)\n    try:\n        process(DATA, state)\n        assert state.total(\"alpha\") == 5 and state.checkpoint == 3\n        assert state.total(\"absent\") == 0\n        for bad in [None, {}, *[{\"tenant\":\"alpha\",\"event_id\":\"bad\",\"amount\":v} for v in [True, 1.5, 2**31, -(2**31)-1]], *[{\"tenant\":v,\"event_id\":\"bad\",\"amount\":1} for v in [\"\", 1]], *[{\"tenant\":\"alpha\",\"event_id\":v,\"amount\":1} for v in [\"\", None, 1]]]:\n            try: process(DATA + [bad], state)\n            except ValueError: pass\n            else: raise AssertionError(\"malformed record accepted\")\n            assert state.checkpoint == 3 and state.total(\"alpha\") == 5\n        process(DATA + [{\"tenant\":\"alpha\",\"event_id\":\"e3\",\"amount\":4}], state)\n        assert state.total(\"alpha\") == 9 and state.checkpoint == 4\n    finally: state.close()\n    source = path.parent / \"cli.jsonl\"\n    source.write_text(\"\".join(json.dumps(row)+\"\\n\" for row in DATA))\n    cli_path = path.parent / \"cli.sqlite\"\n    result = subprocess.run([sys.executable,\"-m\",\"eventflow.cli\",str(source),\"--state\",str(cli_path)], cwd=Path.cwd(), capture_output=True, text=True, timeout=3)\n    assert result.returncode == 0 and json.loads(result.stdout) == {\"checkpoint\":3}, \"CLI contract changed: \" + result.stderr\n    cli_state=State(cli_path)\n    try: assert cli_state.total(\"alpha\") == 5 and cli_state.checkpoint == 3\n    finally: cli_state.close()\n    print(\"R1 parsing boundaries, malformed preservation, totals and CLI passed; signed64 aggregate overflow remains unmeasured\")\n\ndef identity(path):\n    state = State(path)\n    records = DATA + [{\"tenant\":\"beta\",\"event_id\":\"e1\",\"amount\":3}]\n    try:\n        process(records, state)\n        assert state.total(\"alpha\") == 5 and state.total(\"beta\") == 3\n        try: process(records + [{\"tenant\":\"alpha\",\"event_id\":\"e1\",\"amount\":99}], state)\n        except ValueError: pass\n        else: raise AssertionError(\"conflicting identity silently accepted\")\n        assert state.total(\"alpha\") == 5 and state.checkpoint == 4\n    finally: state.close()\n    reopened = State(path)\n    try:\n        process(records, reopened)\n        assert reopened.total(\"alpha\") == 5 and reopened.checkpoint == 4\n    finally: reopened.close()\n    old_path = path.parent / \"old.sqlite\"\n    old_path.write_bytes(base64.b64decode((Path(__file__).parent/\"original-state.b64\").read_text()))\n    old=State(old_path)\n    try:\n        assert old.total(\"alpha\") == 5 and old.checkpoint == 3\n        process(DATA + [{\"tenant\":\"alpha\",\"event_id\":\"e1\",\"amount\":7},{\"tenant\":\"alpha\",\"event_id\":\"e3\",\"amount\":4}],old)\n        assert old.total(\"alpha\") == 9 and old.checkpoint == 5\n    finally: old.close()\n    print(\"R2 tenant identity, conflict, replay and original successful state compatibility passed\")\n\ndef recovery(path):\n    for mode in [\"exit\", \"exception\"]:\n        for position in [1,2]:\n            current = path.with_name(mode+str(position)+\".sqlite\")\n            if mode == \"exit\":\n                code = \"import os;from eventflow import State,process;state=State(__import__('sys').argv[1]);process(\" + repr(DATA) + \",state,after_commit=lambda position: os._exit(73) if position==\" + str(position) + \" else None)\"\n                child = subprocess.run([sys.executable,\"-c\",code,str(current)],cwd=Path.cwd(),stdin=subprocess.DEVNULL,stdout=subprocess.PIPE,stderr=subprocess.PIPE,timeout=3)\n                assert child.returncode == 73, \"fault injection did not reach committed-event boundary\"\n            else:\n                state=State(current)\n                def hook(observed):\n                    if observed==position: raise RuntimeError(\"injected-after-commit\")\n                try:\n                    try: process(DATA,state,after_commit=hook)\n                    except RuntimeError as error: assert str(error)==\"injected-after-commit\"\n                    else: raise AssertionError(\"required callback did not raise\")\n                finally: state.close()\n            reopened=State(current)\n            try:\n                assert reopened.total(\"alpha\") == (7 if position==1 else 5), \"R3 callback ran before the required durable event effect\"\n                assert 0 <= reopened.checkpoint <= position, \"checkpoint skipped an unapplied record\"\n                process(DATA,reopened)\n                observed=reopened.total(\"alpha\")\n                assert observed == 5, \"R3 replay double-applied a committed event: expected total5, observed \" + str(observed)\n                assert reopened.checkpoint == 3\n            finally: reopened.close()\n    print(\"R3 pre-replay durability and complete-source recovery passed for exit/exception at positions1/2\")\n\nwith tempfile.TemporaryDirectory(prefix=\"ingest-check-\", dir=Path.cwd()) as temporary:\n    {\"ordinary\":ordinary,\"identity\":identity,\"recovery\":recovery}[sys.argv[1]](Path(temporary)/\"state.sqlite\")\n",
  "original-state.b64": "\n"
}
